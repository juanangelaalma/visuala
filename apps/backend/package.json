{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ai:check-config": "bun src/scripts/ai-service.ts check-config",
    "ai:smoke:text": "bun src/scripts/ai-service.ts smoke:text",
    "ai:smoke:structured": "bun src/scripts/ai-service.ts smoke:structured",
    "ai:smoke:vision": "bun src/scripts/ai-service.ts smoke:vision",
    "trigger:dev": "pnpm dlx trigger.dev@4.7.3 dev",
    "trigger:deploy": "pnpm dlx trigger.dev@4.7.3 deploy"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@supabase/supabase-js": "^2.108.2",
    "@trigger.dev/sdk": "4.7.3",
    "@visuala/db": "workspace:*",
    "elysia": "^1.4.30",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "gsap": "^3.15.0",
    "hyperframes": "0.8.141",
    "linkedom": "0.18.13",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@trigger.dev/build": "4.7.3",
    "@types/node": "^20",
    "@visuala/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
