{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "ai:check-config": "bun src/scripts/ai-service.ts check-config",
    "ai:smoke:text": "bun src/scripts/ai-service.ts smoke:text",
    "ai:smoke:structured": "bun src/scripts/ai-service.ts smoke:structured",
    "ai:smoke:vision": "bun src/scripts/ai-service.ts smoke:vision"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@supabase/supabase-js": "^2.108.2",
    "@visuala/db": "workspace:*",
    "elysia": "^1.4.30",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@visuala/config": "workspace:*",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
