{
  "extends": "@visuala/config/tsconfig/base",
  "compilerOptions": {
    "lib": ["ESNext"],
    "target": "ESNext",
    "types": ["node"],
    "useDefineForClassFields": false,
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*.ts", "*.mts", "trigger.config.ts"],
  "exclude": ["node_modules"]
}
