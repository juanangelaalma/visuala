# Backend API
PORT=4000
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Local Supabase: run `supabase start` in apps/backend, then use its API URL and keys.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-supabase-service-role-key
SUPABASE_ASSET_BUCKET=assets
ADMIN_EMAILS=

# AI provider setup. Keep both JSON values valid JSON; populate profiles/tasks and provider
# credentials when enabling the AI routes. A profile's apiKeyEnv/modelIdEnv reference env names.
# composition_planner runs twice: structured scene plan, then complete index.html via generateText.
# Give its profile enough maxOutputTokens for full HTML (e.g. 8192+) and sufficient input for frame.md.
AI_MAX_CONCURRENCY=4
AI_LOG_RESPONSES=false
AI_PROFILES_JSON=[]
AI_TASKS_JSON=[]
# AI_PRIMARY_API_KEY=
# AI_PRIMARY_MODEL_ID=

# Billing. Replace credentials with Xendit sandbox values before using billing routes.
BILLING_CHECKOUT_ENABLED=false
BILLING_QRIS_ENABLED=false
BILLING_VIRTUAL_ACCOUNT_ENABLED=false
XENDIT_ENVIRONMENT=sandbox
XENDIT_API_KEY=replace-with-xendit-sandbox-api-key
XENDIT_WEBHOOK_TOKEN=replace-with-xendit-webhook-token
XENDIT_REQUEST_TIMEOUT_MS=10000

# Video asset constraints (defaults shown).
VIDEO_MAX_ASSETS_PER_PROJECT=8
VIDEO_MAX_PROJECT_ASSET_BYTES=41943040
VIDEO_MIN_IMAGE_DIMENSION=1
VIDEO_MAX_IMAGE_DIMENSION=8000
VIDEO_MAX_RENDER_OUTPUT_BYTES=524288000

# Render worker. RENDER_STALE_JOB_MS must be greater than RENDER_JOB_TIMEOUT_MS.
RENDER_WORKER_POLL_MS=2000
RENDER_WORKER_CONCURRENCY=1
RENDER_JOB_TIMEOUT_MS=600000
RENDER_STALE_JOB_MS=900000
# Optional paths; leave unset to use the engine defaults.
# RENDER_WORK_DIR=
# HYPERFRAMES_BROWSER_PATH=
# HYPERFRAMES_FFMPEG_PATH=
# HYPERFRAMES_EXTRACT_CACHE_DIR=
PRODUCER_LOW_MEMORY_MODE=false
PRODUCER_MAX_WORKERS=1
PRODUCER_DISABLE_GPU=true
