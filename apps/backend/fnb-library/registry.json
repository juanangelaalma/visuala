{
  "version": "2.0",
  "frame": {
    "width": 1080,
    "height": 1920,
    "safeArea": {
      "top": "8%",
      "right": "8%",
      "bottom": "12%",
      "left": "8%"
    }
  },
  "styles": [
    "styles/tokens.css",
    "styles/base.css",
    "styles/components.css",
    "styles/layouts.css"
  ],
  "motionRegistry": "motions/registry.json",
  "contracts": {
    "paths": "All main-registry paths are relative to fnb-library/. Motion-registry paths are relative to motions/.",
    "fragments": "Parse a fragment, select its single root, set data-variant, and insert into a sized .hf-frame. No component JavaScript is required.",
    "assets": "Replace img[data-asset] src/alt. Background artwork uses --background-image:url(...). Embedded SVG placeholders are portable.",
    "animationTargets": "Resolve [data-animate] on the component root AND its descendants. Motion targets are alternatives unless behavior.targetSelection says otherwise; choose the intended compatible target, not every alternative.",
    "motionPose": "Motion transforms are deltas from the authored visual pose; do not replace static scale/rotate/translate. Apply additive transforms or a temporary runtime wrapper.",
    "composition": "Layout slots are empty containers for independent component roots. .hf-place accepts --x/--y/--w/--h percentages and --z.",
    "runtime": "This library supplies static visuals and motion intent only. The consuming Hyperframes scene supplies deterministic timing and runtime adapters."
  },
  "components": {
    "ProductHero": {
      "file": "components/product-hero.html",
      "selector": "[data-component='ProductHero']",
      "purpose": "Dominant product image",
      "variants": [
        "clean",
        "impact",
        "floating",
        "editorial",
        "oversized"
      ],
      "defaultVariant": "clean",
      "assets": [
        "product"
      ],
      "animationTargets": [
        "backdrop",
        "shadow",
        "product"
      ],
      "compatibleMotions": [
        "product.impact-in",
        "product.float-in",
        "product.zoom-reveal",
        "product.slide-up"
      ],
      "recommendedUse": [
        "product-launch",
        "discount",
        "product-highlight"
      ],
      "cssVariables": [
        "--product-scale",
        "--product-rotation",
        "--backdrop-color",
        "--brand-secondary"
      ]
    },
    "ProductStack": {
      "file": "components/product-stack.html",
      "selector": "[data-component='ProductStack']",
      "purpose": "Two to five products",
      "variants": [
        "fan",
        "stack",
        "row",
        "hero-secondary"
      ],
      "defaultVariant": "fan",
      "assets": [
        "product"
      ],
      "animationTargets": [
        "product"
      ],
      "compatibleMotions": [
        "product.impact-in",
        "product.float-in",
        "product.zoom-reveal",
        "product.slide-up"
      ],
      "recommendedUse": [
        "bundle",
        "menu-highlight"
      ],
      "cssVariables": [
        "--product-count"
      ],
      "itemCount": {
        "min": 2,
        "max": 5,
        "cssVariable": "--product-count"
      }
    },
    "IngredientBurst": {
      "file": "components/ingredient-burst.html",
      "selector": "[data-component='IngredientBurst']",
      "purpose": "Individually positioned ingredients",
      "variants": [
        "radial",
        "scatter",
        "top-drop",
        "side-burst"
      ],
      "defaultVariant": "radial",
      "assets": [
        "ingredient"
      ],
      "animationTargets": [
        "ingredient"
      ],
      "compatibleMotions": [
        "ingredients.radial-burst",
        "ingredients.falling",
        "ingredients.orbit"
      ],
      "recommendedUse": [
        "product-launch",
        "flavor-highlight"
      ],
      "cssVariables": [
        "--ingredient-size",
        "--ingredient-x",
        "--ingredient-y",
        "--ingredient-rotation"
      ],
      "itemIndex": "data-index (stable zero-based index)"
    },
    "BrandBackground": {
      "file": "components/brand-background.html",
      "selector": "[data-component='BrandBackground']",
      "purpose": "Branded scene background",
      "variants": [
        "solid",
        "split",
        "radial",
        "pattern",
        "editorial"
      ],
      "defaultVariant": "solid",
      "assets": [
        "background"
      ],
      "animationTargets": [
        "background"
      ],
      "compatibleMotions": [
        "typography.mask-reveal",
        "typography.kinetic-up"
      ],
      "recommendedUse": [
        "product-launch",
        "discount",
        "bundle",
        "product-highlight"
      ],
      "cssVariables": [
        "--background-color",
        "--brand-secondary",
        "--background-secondary",
        "--background",
        "--background-image"
      ]
    },
    "DiscountBadge": {
