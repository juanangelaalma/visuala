    "ai:smoke:text": "tsx --conditions=react-server scripts/ai-service.ts smoke:text",
    "ai:smoke:structured": "tsx --conditions=react-server scripts/ai-service.ts smoke:structured",
    "ai:smoke:vision": "tsx --conditions=react-server scripts/ai-service.ts smoke:vision"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1107.0",
